{
  "name": "functions",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "jest --verbose",
    "test:integracion": "firebase emulators:exec --only firestore --project demo-rebottle \"jest --config jest.integracion.config.js --runInBand --verbose\"",
    "emuladores": "firebase emulators:start --only auth,firestore --project rebottle-tesis"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "firebase-functions-test": "^3.4.1",
    "firebase-tools": "^14.27.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.0"
  },
  "private": true
}
