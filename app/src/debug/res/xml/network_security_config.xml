<?xml version="1.0" encoding="utf-8"?>
<!--
    Solo para builds de debug (y por lo tanto para las pruebas
    instrumentadas): permite HTTP sin cifrar hacia el Firebase
    Emulator Suite que corre en la máquina de desarrollo.
    10.0.2.2 = localhost del PC visto desde el emulador de Android.
    127.0.0.1 = dispositivo físico usando `adb reverse`.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
